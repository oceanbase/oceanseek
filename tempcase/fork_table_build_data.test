#####################
# owner : fork-table
# owner group : storage
# description : 从 oceanbase-lite(share-nothing) 的 fork_table_build_data.test 适配到 SS obtest --
#               fork 前置 DDL(删列) 与 major freeze 交互下的数据一致性。
#               场景1: 源表删列后 fork,目标表不含被删列、数据与删列后的源表一致,fork 后 major freeze 不卡住。
#               场景2: major freeze 落 base major 后,再插数据、删列、fork,目标表反映删列后的全量快照
#                      (reuse base major + rewrite delta 合并)。
#####################

--echo "1. =========== bootstrap shared-storage cluster ==========="
ob1=OBI(cluster=1:1:1, proxy_num=0, init_unit_cpu=0);
source include/mini_ob_config.inc;
ob1.set extra_config=$mini_ob_config;
ob1.reboot;

let $proxy_ip = deploy_get_value(ob1.z1.obs0.ip);
let $proxy_port = deploy_get_value(ob1.z1.obs0.mysql_port);
connect(sys_conn, $proxy_ip, root@sys,,oceanbase, $proxy_port);

--echo "2. =========== create mysql tenant ==========="
source include/create_unit_config.inc;
ob1.mysql CREATE RESOURCE POOL fork_build_pool UNIT = "2c2g", UNIT_NUM = 1, ZONE_LIST = ('z1', 'z2', 'z3');
ob1.mysql CREATE TENANT fork_build_tenant RESOURCE_POOL_LIST=('fork_build_pool'), locality='F@z1,F@z2,F@z3', primary_zone='z1' SET ob_tcp_invited_nodes='%';
let $tenant_id = deploy_get_value(ob1.select select tenant_id from oceanbase.__all_tenant where tenant_name='fork_build_tenant', tenant_id, 1);

connect(mysql_conn, $proxy_ip, root@fork_build_tenant,,test, $proxy_port);
connection mysql_conn;
set recyclebin = off;

--echo "3. =========== 源表删列后 fork: 目标表不含被删列、数据与删列后源表一致 ==========="
# range 分区表,先在源表 drop 一列再 fork。dst 的 schema 应为删列后的形态,数据按删列后的快照复制。
create table t1 (
    id int primary key,
    c1 varchar(20),
    c2 int,
    drop_col varchar(20)
) partition by range(id) (
    partition p0 values less than (100),
    partition p1 values less than (200)
);
insert into t1 values (1, 'a', 10, 'd1');
insert into t1 values (101, 'b', 20, 'd2');
# 先在源表删列
alter table t1 drop column drop_col;
set @fork_sql = 'fork table t1 to t1_fork'; prepare fork_t1_stmt from @fork_sql; execute fork_t1_stmt; deallocate prepare fork_t1_stmt;
connection sys_conn;
ob1.check_until_timeout select count(*) from oceanbase.__all_virtual_ddl_task_status where tenant_id = $tenant_id and ddl_type = 1019, 0, 180;
connection mysql_conn;
# 目标表行数与删列后源表一致
let $t1_cnt = query_get_value(select count(*) as cnt from t1_fork, cnt, 1);
if ($t1_cnt != 2)
{
  --echo ERROR: dst row count should be 2 after drop column
  --exit
}
# 两行数据均与删列后的源表一致(全用 count 做存在性断言,避免字符串比较)
let $t1_row1 = query_get_value(select count(*) as cnt from t1_fork where id = 1 and c1 = 'a' and c2 = 10, cnt, 1);
if ($t1_row1 != 1)
{
  --echo ERROR: dst row id=1 mismatch after drop column
  --exit
}
let $t1_row2 = query_get_value(select count(*) as cnt from t1_fork where id = 101 and c1 = 'b' and c2 = 20, cnt, 1);
if ($t1_row2 != 1)
{
  --echo ERROR: dst row id=101 mismatch after drop column
  --exit
}
# 被删除的列不应出现在目标表 schema 中
let $t1_dropcol = query_get_value(select count(*) as cnt from information_schema.columns where table_schema = database() and table_name = 't1_fork' and column_name = 'drop_col', cnt, 1);
if ($t1_dropcol != 0)
{
  --echo ERROR: dropped column should not exist in dst schema
  --exit
}
# fork 后触发 major freeze 并等待完成,验证不会卡住
connection sys_conn;
alter system major freeze tenant fork_build_tenant;
source include/compaction/wait_tenant_major_finish_on_ss.inc;
connection mysql_conn;

--echo "4. =========== major freeze 后再插数据、删列、fork ==========="
create table t2 (
    id int primary key,
    c1 varchar(20),
    c2 int,
    drop_col varchar(20)
) partition by range(id) (
    partition p0 values less than (100),
    partition p1 values less than (200)
);
insert into t2 values (1, 'a1', 10, 'd1');
insert into t2 values (101, 'b1', 20, 'd2');
# 先触发 major freeze 落 base major
connection sys_conn;
alter system major freeze tenant fork_build_tenant;
source include/compaction/wait_tenant_major_finish_on_ss.inc;
connection mysql_conn;
# major 之后再插两行(停在 memtable/minor)
insert into t2 values (2, 'a2', 30, 'd3');
insert into t2 values (102, 'b2', 40, 'd4');
# 删列后 fork: dst 需合并 reuse 的 base major + rewrite 的 delta,且不含被删列
alter table t2 drop column drop_col;
set @fork_sql = 'fork table t2 to t2_fork'; prepare fork_t2_stmt from @fork_sql; execute fork_t2_stmt; deallocate prepare fork_t2_stmt;
connection sys_conn;
ob1.check_until_timeout select count(*) from oceanbase.__all_virtual_ddl_task_status where tenant_id = $tenant_id and ddl_type = 1019, 0, 180;
connection mysql_conn;
# dst 应包含 base major 的两行 + major 后插入的两行 = 4 行
let $t2_cnt = query_get_value(select count(*) as cnt from t2_fork, cnt, 1);
if ($t2_cnt != 4)
{
  --echo ERROR: dst row count should be 4 (base major + post-major delta)
  --exit
}
let $t2_sum = query_get_value(select sum(c2) as s from t2_fork, s, 1);
if ($t2_sum != 100)
{
  --echo ERROR: dst data mismatch (expect 10+20+30+40=100)
  --exit
}
# major 之前(进 base major)与之后(进 delta)的行都要在 dst
let $t2_base_row = query_get_value(select count(*) as cnt from t2_fork where id = 1 and c1 = 'a1' and c2 = 10, cnt, 1);
if ($t2_base_row != 1)
{
  --echo ERROR: base-major row (id=1) missing in dst
  --exit
}
let $t2_delta_row = query_get_value(select count(*) as cnt from t2_fork where id = 2 and c1 = 'a2' and c2 = 30, cnt, 1);
if ($t2_delta_row != 1)
{
  --echo ERROR: post-major delta row (id=2) missing in dst
  --exit
}
let $t2_dropcol = query_get_value(select count(*) as cnt from information_schema.columns where table_schema = database() and table_name = 't2_fork' and column_name = 'drop_col', cnt, 1);
if ($t2_dropcol != 0)
{
  --echo ERROR: dropped column should not exist in dst schema
  --exit
}
# 再次 major freeze 验证 fork 后合并不卡住
connection sys_conn;
alter system major freeze tenant fork_build_tenant;
source include/compaction/wait_tenant_major_finish_on_ss.inc;
connection mysql_conn;

--echo "5. =========== cleanup ==========="
connection sys_conn;
drop tenant fork_build_tenant force;

--echo "fork_table_build_data finished"
